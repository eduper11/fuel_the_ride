<?xml version="1.0" encoding="utf-8"?>
<!--
    clip_fill_blue.xml — relleno del depósito de BEBIDA.
    ClipDrawable con gravity=bottom: el nivel (setImageLevel 0..10000) controla
    qué fracción se ve, anclada abajo. Al bajar el nivel se vacía de arriba a abajo.
-->
<clip xmlns:android="http://schemas.android.com/apk/res/android"
    android:clipOrientation="vertical"
    android:gravity="bottom">
    <shape android:shape="rectangle">
        <solid android:color="#15539E" />
    </shape>
</clip>
